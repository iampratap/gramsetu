PORT=4000
# Host npm/dev uses localhost. docker compose overrides this to host `db`.
DATABASE_URL="postgresql://gramsetu:gramsetu@localhost:5432/gramsetu?schema=public"
JWT_SECRET="change-me"
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://sfo3.digitaloceanspaces.com"
S3_FORCE_PATH_STYLE="false"
S3_BUCKET="lyftek-dev-storage"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_REGION="sfo3"
# Or disk mirror: STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
